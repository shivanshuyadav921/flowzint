# ==============================================================================
# FLOWZINT - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. FRONTEND / VERCEL ENVIRONMENT VARIABLES
# ------------------------------------------------------------------------------
# (Add these in Vercel Dashboard -> Project -> Settings -> Environment Variables)

# Frontend API URL
# Leave empty or set to /api for native Vercel serverless API (recommended)
# Or set to your dedicated FastAPI backend URL (e.g. https://api.yourdomain.com/api)
NEXT_PUBLIC_API_URL=/api

# Google OAuth Client ID (Optional: enables official Google 1-Click Sign-In)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Server Secret Key for JWT token signing (Recommended: generate 32+ random characters)
SECRET_KEY=flowzint-production-secret-key-min-32-chars-long

# AI Provider API Keys (Optional on Vercel: intelligent offline evaluation is used if not provided)
OPENAI_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=

# ------------------------------------------------------------------------------
# 2. BACKEND (FASTAPI / DOCKER) CONFIGURATION
# ------------------------------------------------------------------------------
# Database URL (SQLite default for local, PostgreSQL for production RDS/Supabase)
DATABASE_URL=sqlite:///./app.db

# CORS Allowed Origins
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:3001","https://*.vercel.app"]

# ChromaDB Semantic Storage Directory
CHROMA_PERSIST_DIR=./chroma_store
STORAGE_PROVIDER=sqlite

# Email & Notification Settings (Optional)
EMAIL_SENDER=noreply@flowzint.com
SMTP_SERVER=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
